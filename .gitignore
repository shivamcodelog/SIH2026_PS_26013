# ==============================================================================
# SIH26013 - Root .gitignore
# ==============================================================================

# Node / JavaScript Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs & Bundles
dist/
**/dist/
dist-ssr/
build/
**/build/
out/
.next/
*.tsbuildinfo

# Environment & Secrets (NEVER commit credentials)
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt

# Python & Geospatial Engine
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/
*.egg-info/
.mypy_cache/

# Databases & Local Dumps
*.sqlite
*.sqlite3
*.db
*.dump
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
uploads/
**/uploads/

# IDEs, Editors & Tooling
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Agent / Local IDE Workspace Caches
.gemini/
.cache/
.turbo/
.vercel/
