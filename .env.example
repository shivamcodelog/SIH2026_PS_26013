# ==============================================================================
# SIH26013 - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih26013_landrecords
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih26013_landrecords

# ------------------------------------------------------------------------------
# 2. Node.js Express API Backend (node-server)
# ------------------------------------------------------------------------------
NODE_PORT=5000
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Python FastAPI Geospatial Engine (geo-engine)
# ------------------------------------------------------------------------------
GEO_ENGINE_HOST=127.0.0.1
GEO_ENGINE_PORT=8000
FASTAPI_PORT=8000
GEO_ENGINE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Frontend (Vite + React)
# ------------------------------------------------------------------------------
FRONTEND_API_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
VITE_MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
